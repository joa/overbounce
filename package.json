{
  "name": "overbounce",
  "version": "0.1.0",
  "description": "A 3D sidescrolling speedrunning game with bug-for-bug faithful Quake III Arena physics",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:physics": "vitest run test/physics",
    "test:collision": "vitest run test/collision",
    "test:game": "vitest run test/game",
    "test:watch": "vitest",
    "replay": "tsx tools/replay.ts",
    "probe": "tsx tools/probe.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "@webgpu/types": "^0.1.71",
    "eslint": "^9.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
