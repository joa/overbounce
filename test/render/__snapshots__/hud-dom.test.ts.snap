      <div class="ob-debug-grid" data-debug-grid=""><span>pos <b>128 -65 40</b></span><span>yaw <b>137°</b></span><span>ground <b style="color:#ffd166">air 0.42s</b></span><span>jumps <b>17</b></span><span>cpu <b>8.31ms</b></span><span> <b>60 fps</b></span><span>gpu <b>2.14ms</b></span><span>draws <b>179</b></span><span>tris <b>55.9k</b></span></div>
    </div>

    <div class="ob-instrument">
      <div class="ob-trace">
