          <polyline data-trace-line="" fill="none" stroke="#ffd166" stroke-width="2.5" stroke-linejoin="round" style="display: none;"></polyline>
        </svg>
        <div class="ob-trace-caption mono">10s · 320 cap</div>
      </div>
      <div class="ob-speedbox">
        <div class="ob-speed-row">
          <div class="ob-speed-num" data-speed="" style="color: #7ee081;">413</div>
          <div class="ob-speed-unit">UPS</div>
        </div>
        <div class="ob-cap-bar">
          <div class="ob-cap-fill" data-cap-fill="" style="width: 32.75396825396825%;"></div>
          <div class="ob-cap-tick" style="left:25.396825396825395%"></div>
        </div>
        <div class="ob-strafe-row hidden" data-strafe="">
          <div class="ob-strafe-track">
            <div class="ob-strafe-window" data-strafe-window=""></div>
            <div class="ob-strafe-best" data-strafe-best=""></div>
            <div class="ob-strafe-you" data-strafe-you=""></div>
          </div>
