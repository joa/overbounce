node_modules/
dist/
*.log
.DS_Store

# Q3/OpenArena game data. No THIRD-PARTY maps are committed to this
# repository: assets from a commercial Quake III Arena installation are not
# redistributable at all, and the licensing of individual OpenArena community
# maps is not documented per file. Fetch one locally instead — see the
# "Testing against a real map" section of the README. See also NOTICE.
*.pk3
*.bsp
*.aas
*.md3
*.skin
/assets/
/baseq3/
/baseoa/
/test/render/output/

# /maps/ is the one exception: it holds this project's OWN map source
# (maps/ob_basics.map) and its compiled maps/ob_basics.bsp, not third-party
# content, so the rule above doesn't apply to it. `public/maps/` (every
# OTHER bsp, fetched or devpak-built) is still caught by the blanket *.bsp
# above and stays local.
!/maps/*.bsp

# GPL C sources fetched by `npm run download-assets --refs`. Read during porting
# and diffed against, never imported and never shipped. They are upstream's to
# distribute, not ours.
/refs/

# Scratch files from code generation. Never meant to be committed.
*.tmp.*
*.tmp.ts
diag.tmp.*

# Screenshots taken while verifying rendering work. Useful on disk, useless in
# git: multi-megabyte PNGs that go stale the moment the renderer changes. The
# scratchpad is the right home for them; this catches the ones that land here.
.agent/docs/shots/
shots/
